# Copy this file to .env (never commit .env) and fill in the values.

# PostgreSQL connection string for the shared database, for example:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# The API answers 503 until this is set.
DATABASE_URL=

# Allowed frontend origins, comma separated. "*" is fine while the API is public and read-only.
NEBO_CORS_ORIGINS=*

# Optional tuning.
# NEBO_MAX_PARALLEL_DOWNLOADS=6
# NEBO_MAX_CONCURRENT_BUILDS=2
# NEBO_HTTP_TIMEOUT_S=180

# Only for running the PostgresStore tests against a throwaway database.
# NEBO_TEST_DATABASE_URL=

# Optional local Docker PostgreSQL (matches root docker-compose.yml):
# postgresql://nebo:nebo_secret@localhost:5432/nebo_spherex

# Optional Google Cloud Storage cache & archival (project nebo-514718).
# NEBO_GCS_PROJECT=nebo-514718
# NEBO_GCS_BUCKET=nebo-514718-spherex-assets
# NEBO_GCS_PREFIX=nebo-spherex
